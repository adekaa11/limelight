# --- Supabase (если пусто, данные пишутся локально в backend/data/) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=days
SUPABASE_TABLE=days

# --- LLM: gemini | groq | none (none = только правила, без сети) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Сервер ---
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://*.vercel.app
MAX_PHOTOS=8
MAX_UPLOAD_MB=20
